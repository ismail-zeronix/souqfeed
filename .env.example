# Local dev defaults below match docker-compose.yml's postgres/redis,
# published on localhost — copy this file to .env and it works as-is.
#
# For production (compose.yaml, which does NOT publish ports to the
# host), DATABASE_URL and REDIS_URL must use the Compose service names
# as the host instead of localhost (e.g. postgres:5432, redis:6379),
# and BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL must be the real public
# https:// domain (e.g. https://souqfeed.com). See docs/deployment.md.
DATABASE_URL=postgresql://souqfeed:souqfeed@localhost:5432/souqfeed
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug
ADMIN_EMAIL=admin@souqfeed.local
ADMIN_PASSWORD=changeme-admin-1234

# Consumed only by compose.yaml's `postgres` service (production) to
# initialize that container's credentials. Must match the user,
# password, and db name embedded in DATABASE_URL above exactly, or the
# app will fail to connect. Not read by the app itself (src/lib/validation/env.ts
# only validates DATABASE_URL as a whole connection string).
POSTGRES_USER=souqfeed
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=souqfeed
